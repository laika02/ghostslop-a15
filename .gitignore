# Default-deny this mixed research workspace: only the A15 source, launcher,
# license, build file, README, and one-boot result record are tracked.
/*
!/.gitignore
!/LICENSE
!/Makefile
!/README.md
!/src/
!/src/**
!/scripts/
/scripts/*
!/scripts/adb-trigger.sh
!/scripts/termux-trigger.sh
!/scripts/defex-exec.sh
!/scripts/g4run.sh
!/scripts/g4run-fish-init.fish
!/scripts/g4run-init.sh
!/docs/
/docs/*
!/docs/A15-ONE-BOOT-RESULT.md
!/docs/DEFEX-SAFEPLACE.md
!/docs/G4SH-PTY.md

# Generated build products and local captures are never source.
*.o
*.a
*.so
*.d
*.log
*.raw
*.raw.gz
*.zip
*.img
*.elf
*.dtb
*.dtbo
*.ko
*.pid
*.core
.DS_Store
