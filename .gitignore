# Default-deny this mixed research workspace. The tracked A15 project includes
# the root manager app, native helpers, launchers, and reviewable documentation.
/*
!/.gitignore
!/LICENSE
!/Makefile
!/README.md
!/src/
!/src/**
!/scripts/
/scripts/*
!/scripts/adb-trigger.sh
!/scripts/termux-trigger.sh
!/scripts/defex-exec.sh
!/scripts/g4run.sh
!/scripts/g4run-fish-init.fish
!/scripts/g4run-init.sh
!/docs/
/docs/*
!/docs/A15-ONE-BOOT-RESULT.md
!/docs/DEFEX-SAFEPLACE.md
!/docs/G4SH-PTY.md
!/docs/ROOT-MANAGER.md
!/bootstrap-app/
!/bootstrap-app/**

# Generated build products and local captures are never source.
*.o
*.a
*.so
*.d
*.log
*.raw
*.raw.gz
*.zip
*.img
*.elf
*.dtb
*.dtbo
*.ko
*.pid
*.core
.DS_Store
